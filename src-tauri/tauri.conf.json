{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rTerm",
  "version": "0.1.0",
  "identifier": "app.rseries.rterm",
  "build": {
    "beforeDevCommand": "npm --prefix ./web run dev -- --host 127.0.0.1 --port 1430 --strictPort",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "npm --prefix ./web run build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "rTerm",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 720,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
